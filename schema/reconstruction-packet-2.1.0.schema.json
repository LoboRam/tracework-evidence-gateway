    "reconstruction_packet_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "reconstruction_packet_schema_version": {
      "type": "string",
      "const": "2.1.0"
    },
    "reconstruction_protocol_version": {
      "type": "string",
      "const": "historical-0.4"
    },
    "provenance_schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "provider": {
      "type": "string",
      "enum": [
        "chatgpt",
        "claude",
        "codex",
        "other",
        "manual"
      ]
    },
    "coverage_perimeter": {
      "type": "object",
      "properties": {
        "accepted_reconstruction_coverage_snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9._:-]+$"
