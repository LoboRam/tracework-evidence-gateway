        "recovery_pass_ids": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "manifest_ids": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "earliest_date": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "maxLength": 80
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "precision": {
              "type": "string",
              "enum": [
                "day",
                "month",
                "year",
                "range",
                "unknown"
              ]
            }
          },
          "required": [
            "label",
            "precision"
          ],
          "additionalProperties": false
        },
        "latest_date": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "maxLength": 80
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "precision": {
              "type": "string",
              "enum": [
                "day",
                "month",
                "year",
                "range",
                "unknown"
              ]
            }
          },
          "required": [
            "label",
            "precision"
          ],
          "additionalProperties": false
        },
        "coverage_confidence": {
          "type": "string",
          "enum": [
            "strong",
            "partial",
            "limited"
          ]
        },
        "limitations": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
