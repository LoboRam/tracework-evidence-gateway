            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 80
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "precision": {
                "type": "string",
                "enum": [
                  "day",
                  "month",
                  "year",
                  "range",
                  "unknown"
                ]
              }
